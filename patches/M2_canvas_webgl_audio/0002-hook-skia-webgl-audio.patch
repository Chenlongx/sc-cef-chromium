@@ -181,6 +182,21 @@
   GetCurrentUnpackState(params)
 
 namespace blink {
+namespace {
+// SC-CEF M2: WebGL UNMASKED_* spoof helpers
+bool ScFpWebGlVendor(String* out) {
+  std::string v;
+  if (!sc_fp::OverrideWebGlVendor(&v) || v.empty() || !out) return false;
+  *out = String::FromUTF8(v.c_str());
+  return true;
+}
+bool ScFpWebGlRenderer(String* out) {
+  std::string r;
+  if (!sc_fp::OverrideWebGlRenderer(&r) || r.empty() || !out) return false;
+  *out = String::FromUTF8(r.c_str());
+  return true;
+}
+}  // namespace
 
 bool WebGLRenderingContextBase::webgl_context_limits_initialized_ = false;
 unsigned WebGLRenderingContextBase::max_active_webgl_contexts_ = 0;
